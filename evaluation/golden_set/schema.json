{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TruthCheck golden-set candidate",
  "type": "object",
  "required": ["id", "original_text", "expected_class", "language", "source", "review_status"],
  "properties": {
    "id": {"type": "string"},
    "original_text": {"type": "string", "minLength": 1},
    "expected_class": {"enum": ["FACTUAL", "MISINFORMATION"]},
    "language": {"enum": ["en", "hi", "hinglish", "unknown"]},
    "source": {"type": "string"},
    "source_label": {"type": "integer", "enum": [0, 1]},
    "review_status": {"enum": ["candidate", "approved", "rejected"]},
    "reviewer": {"type": ["string", "null"]},
    "evidence_urls": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  }
}
