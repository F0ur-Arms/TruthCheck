# Copy this file to .env (or export these directly in your shell) to point
# TruthCheck's ConfiguredLLMVerifier at the local vLLM server running on the
# IIITD CB GPU cluster. See docs/LOCAL_LLM_DEPLOYMENT.md for the full
# runbook (starting the server, SSH tunneling, troubleshooting).
#
# Without these set, ConfiguredLLMVerifier.configured is False and the LLM
# routing/decomposition/verification steps fall back to heuristic
# processing -- the app still runs, just without the LLM.

# If you're on the cluster network (or tunneled so this hostname resolves),
# point straight at the compute node:
TRUTHCHECK_LLM_BASE_URL=http://cb-gpu-server:8000/v1

# If you're running TruthCheck on your own machine, first open a tunnel:
#   ssh -L 8000:cb-gpu-server:8000 <username>@cb-cluster.iiitd.edu.in
# then use:
#   TRUTHCHECK_LLM_BASE_URL=http://localhost:8000/v1

# vLLM does not require authentication, but ConfiguredLLMVerifier treats an
# empty key as "not configured" and always sends an Authorization header --
# any non-empty placeholder works.
TRUTHCHECK_LLM_API_KEY=none

# Must match --served-model-name in scripts/cluster/vllm_prod.pbs.
TRUTHCHECK_LLM_MODEL=qwen2.5-7b-awq

# Optional. Default is 30s. The claim-decomposition call in
# src/claims_processor.py currently hardcodes its own 15s timeout
# separately -- see docs/LOCAL_LLM_DEPLOYMENT.md "Known limitations".
TRUTHCHECK_LLM_TIMEOUT_SECONDS=60
